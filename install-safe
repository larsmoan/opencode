#!/usr/bin/env bash
set -euo pipefail

REPOSITORY="larsmoan/opencode"
INSTALL_DIR="${OPENCODE_INSTALL_DIR:-${XDG_BIN_DIR:-$HOME/.local/bin}}"
VERSION="${VERSION:-}"

usage() {
  cat <<EOF
Internal OpenCode installer

Usage: install-safe [options]

Options:
  -h, --help              Display this help message
  -v, --version <version> Install a specific version

Examples:
  curl -fsSL https://raw.githubusercontent.com/larsmoan/opencode/dev/install-safe | bash
  curl -fsSL https://raw.githubusercontent.com/larsmoan/opencode/dev/install-safe | bash -s -- --version 1.18.31-internal.1
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    -v|--version)
      VERSION="${2:?--version requires a version argument}"
      shift 2
      ;;
    *)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
  esac
done

case "$(uname -s)" in
  Darwin) os="darwin" ;;
  Linux) os="linux" ;;
  *)
    echo "Unsupported operating system: $(uname -s)" >&2
    exit 1
    ;;
esac

case "$(uname -m)" in
  arm64|aarch64) arch="arm64" ;;
  x86_64|amd64) arch="x64" ;;
  *)
    echo "Unsupported architecture: $(uname -m)" >&2
    exit 1
    ;;
esac

if [[ "$os" == "darwin" && "$arch" == "x64" ]] && [[ "$(sysctl -n sysctl.proc_translated 2>/dev/null || true)" == "1" ]]; then
  arch="arm64"
fi

baseline=""
musl=""
if [[ "$os" == "linux" ]] && [[ -f /etc/alpine-release || "$(ldd --version 2>&1 || true)" == *musl* ]]; then
  musl="-musl"
fi
if [[ "$arch" == "x64" ]] && [[ "$os" == "linux" ]] && ! grep -qwi avx2 /proc/cpuinfo 2>/dev/null; then
  baseline="-baseline"
fi
target="$os-$arch$baseline$musl"

if [[ -z "$VERSION" ]]; then
  VERSION="$(curl --fail --silent --show-error "https://api.github.com/repos/$REPOSITORY/releases/latest" | sed -n 's/.*"tag_name": *"v\([^"]*\)".*/\1/p')"
fi

if [[ -z "$VERSION" ]]; then
  echo "Could not determine the latest internal release version" >&2
  exit 1
fi

VERSION="${VERSION#v}"
asset="opencode-$target.tar.gz"
release_url="https://github.com/$REPOSITORY/releases/download/v$VERSION"
tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

curl --fail --location --show-error --output "$tmpdir/SHA256SUMS" "$release_url/SHA256SUMS"
curl --fail --location --show-error --output "$tmpdir/$asset" "$release_url/$asset"

if command -v sha256sum >/dev/null 2>&1; then
  expected="$(grep "  $asset$" "$tmpdir/SHA256SUMS" | cut -d ' ' -f 1)"
  actual="$(sha256sum "$tmpdir/$asset" | cut -d ' ' -f 1)"
else
  expected="$(grep "  $asset$" "$tmpdir/SHA256SUMS" | cut -d ' ' -f 1)"
  actual="$(shasum -a 256 "$tmpdir/$asset" | cut -d ' ' -f 1)"
fi

if [[ -z "$expected" || "$expected" != "$actual" ]]; then
  echo "Release checksum verification failed" >&2
  exit 1
fi

tar -xzf "$tmpdir/$asset" -C "$tmpdir"
mkdir -p "$INSTALL_DIR"
install -m 755 "$tmpdir/opencode-$target/bin/opencode" "$INSTALL_DIR/opencode"

echo "Installed safe OpenCode $VERSION to $INSTALL_DIR/opencode"
if [[ ":$PATH:" != *":$INSTALL_DIR:"* ]]; then
  echo "Add $INSTALL_DIR to PATH before running opencode."
fi
